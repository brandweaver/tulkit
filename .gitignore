# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example committed, ignore real .env)
.env
.env.local
.env.production
.env.development

# database (SQLite — regenerated locally)
/db/
*.db
*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
dev.log
server.log

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.claude
.z-ai-config

# build artifacts & sandbox
download/
upload/
.zscripts/
Caddyfile
mini-services/
examples/
tests/
skills/
